# Copy to .env and change the secrets.
DATABASE_URL=postgresql+psycopg://dentbid:dentbid@localhost:5432/dentbid
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=43200
MEDIA_DIR=media
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*
REQUEST_TTL_HOURS=48
DEFAULT_SEARCH_RADIUS_KM=25

# CV models (see ml/README.md). Leave DAMAGE weights empty to run without AI analysis.
DENTBID_DAMAGE_WEIGHTS=../ml/weights/damage.pt
DENTBID_PARTS_WEIGHTS=../ml/weights/parts.pt
DENTBID_CAR_WEIGHTS=yolo11n-seg.pt
DENTBID_DEVICE=cpu

# Expo push notifications (optional access token for higher rate limits)
EXPO_ACCESS_TOKEN=
